    <!-- Tooltips -->
    <string name="tooltip_strategy_scene">检测镜头之间的硬切换。适合将电影或多机位素材分割成独立场景。</string>
    <string name="tooltip_strategy_black">检测完全黑暗的帧。适合查找并移除"淡入黑屏"过渡或空白间隙。</string>
    <string name="tooltip_strategy_freeze">检测连续帧相同的冻结视频片段。适合过滤静态停顿或画面卡顿。</string>
    <string name="tooltip_strategy_blur">检测模糊或失焦的画面，自动过滤掉效果不佳的片段。</string>
    <string name="tooltip_sample_interval">分析频率。较低的间隔（100–200毫秒）可提高精度，但分析较慢；较高间隔（500毫秒以上）更快，但可能错过快速切换。</string>
    <string name="tooltip_sensitivity">检测阈值。较低值可检测到细微变化；较高值仅在明显变化时触发。</string>
    <string name="tooltip_min_segment">保留片段的最小时长。增加此值可避免时间轴上出现短促、碎片化的片段。</string>
    <string name="tooltip_noise_threshold" formatted="false">低于此音频水平的声音被视为静音。如果背景噪音（嗡嗡声、空调声、呼吸声）影响剪辑，请提高此值。</string>
    <string name="tooltip_min_segment_audio">保留音频片段的最小时长。较低值保留短促的声音；较高值过滤咳嗽或麦克风撞击声等短暂噪音。</string>
    <string name="tooltip_min_silence_duration">触发剪辑所需的最小静音时长。较低值创建紧凑的节奏；较高值保留自然停顿。</string>
    <string name="tooltip_padding_prefix">在保留片段开始前添加的缓冲。防止词语开头听起来被截断。</string>
    <string name="tooltip_padding_postfix">在保留片段结束后添加的缓冲。防止音频结束过于突兀。</string>
    <string name="tooltip_detect">开始画面分析。在应用之前，您可以调整并查看时间轴上的预览范围。</string>
    <string name="tooltip_apply_smart_cut">应用剪辑。在主时间轴上丢弃红色片段并合并绿色片段。</string>
    <string name="tooltip_silence_tab">检测并移除静音停顿。适合播客、讲座或访谈视频。</string>
    <string name="tooltip_visual_tab">扫描场景过渡、黑帧或冻结视频。适合屏幕录制或辅助素材。</string>
