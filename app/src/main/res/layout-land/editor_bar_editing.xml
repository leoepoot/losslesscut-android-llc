<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editingControls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:id="@+id/containerPrevFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnPrevFrame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skip_previous_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上一帧"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerNextFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnNextFrame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skip_next_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一帧"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerDelete"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_delete_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/discard_segment"
            android:tooltipText="@string/discard_segment"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit_confirm_discard"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSplit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnSplit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_split_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/split"
            android:tooltipText="@string/split"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSetOut"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnSetOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_trim_right_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/set_out_point"
            android:tooltipText="@string/set_out_point"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/short_out"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSetIn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/btnSetIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_trim_left_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/set_in_point"
            android:tooltipText="@string/set_in_point"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/short_in"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
</LinearLayout>
